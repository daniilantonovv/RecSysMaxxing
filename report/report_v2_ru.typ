    [Переранжирование, $w = 0.3$], [0.1110], [0.1335], [0.1194], [0.534], [0.530], [3.2],
    [Переранжирование, $w = 0.1$], [0.0927], [0.1211], [0.0878], [0.592], [0.435], [2.4],
